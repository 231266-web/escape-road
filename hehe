import pygame
import random

# Initialize Pygame
pygame.init()

# Screen setup
WIDTH, HEIGHT = 600, 800
screen = pygame.display.set_mode((WIDTH, HEIGHT))
pygame.display.set_caption("Escape the Road")

# Colors
WHITE = (255, 255, 255)
RED = (255, 0, 0)

# Car setup
car_width, car_height = 50, 100
car_x = WIDTH // 2 - car_width // 2
car_y = HEIGHT - car_height - 10
car_speed = 5

# Obstacle setup
obstacle_width, obstacle_height = 50, 100
obstacle_speed = 5
obstacles = []

# Clock
clock = pygame.time.Clock()

def draw_car(x, y):
    pygame.draw.rect(screen, RED, (x, y, car_width, car_height))

def draw_obstacles(obstacles):
    for obs in obstacles:
        pygame.draw.rect(screen, WHITE, obs)

# Game loop
running = True
while running:
    screen.fill((0, 0, 0))  # Clear screen

    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False

    # Key press
    keys = pygame.key.get_pressed()
    if keys[pygame.K_LEFT] and car_x > 0:
        car_x -= car_speed
    if keys[pygame.K_RIGHT] and car_x < WIDTH - car_width:
        car_x += car_speed

    # Add obstacles
    if random.randint(1, 20) == 1:
        obs_x = random.randint(0, WIDTH - obstacle_width)
        obstacles.append(pygame.Rect(obs_x, -obstacle_height, obstacle_width, obstacle_height))

    # Move obstacles
    for obs in obstacles:
        obs.y += obstacle_speed
        if obs.colliderect(pygame.Rect(car_x, car_y, car_width, car_height)):
            print("Crashed!")
            running = False

    draw_car(car_x, car_y)
    draw_obstacles(obstacles)

    pygame.display.update()
    clock.tick(60)

pygame.quit()
